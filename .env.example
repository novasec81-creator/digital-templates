# ===== Application =====
# URL publique finale du site. OBLIGATOIRE pour le build de production
# (canonical, sitemap, robots, Open Graph, JSON-LD, mentions légales).
# Le build échoue si elle est absente en production.
NEXT_PUBLIC_APP_URL=https://yourdomain.com
SESSION_SECRET=change-me-to-a-long-random-string-32+chars

# ===== Database (Supabase / Neon) =====
# PostgreSQL connection string. For Neon, use the pooled connection for the app
# and add DIRECT_URL with the direct (non-pooled) URL for Prisma migrations.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Required only with Neon/prisma binary engine:
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===== Stripe =====
# sk_test_xxx for development, sk_live_xxx for production.
# Never commit your live key.
STRIPE_SECRET_KEY="sk_test_..."
# Generated in the Stripe Dashboard > Developers > Webhooks. Used by
# /api/webhooks/stripe to verify event signatures.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: currency code (defaults to eur)
NEXT_PUBLIC_CURRENCY="EUR"

# ===== File storage (Cloudflare R2 or AWS S3) =====
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET="your-downloads-bucket"
S3_REGION="auto"                 # "auto" for R2, e.g. "eu-west-3" for AWS
# R2 only: S3-compatible endpoint (https://<accountid>.r2.cloudflarestorage.com)
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# Optional: public CDN base URL for preview images
S3_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"
# Presigned URL duration before expiry (in seconds)
PRESIGNED_URL_TTL=300

# ===== Transactional email (Resend) =====
RESEND_API_KEY="re_..."
EMAIL_FROM="Store <store@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"

# ===== Rate limiting (Upstash) — optional, falls back to in-memory =====
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# ===== Analytics (optional) =====
# Si AUCUNE n'est renseignée, le site est 100 % statique : pas de bandeau
# cookies, pas de script de mesure, politique de confidentialité alignée.
# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4_ID="G-XXXXXXX"
# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID="xxxxxxxx"